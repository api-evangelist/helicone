{
  "opencollection": "1.0.0",
  "info": {
    "name": "helicone-api Agent Status API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetAllProviderStatus",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.helicone.ai/v1/public/status/provider",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "GetProviderStatus",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.helicone.ai/v1/public/status/provider/:provider",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path"
              },
              {
                "name": "timeFrame",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
